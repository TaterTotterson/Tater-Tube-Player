<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Pairing code rejects public HTTP hosts. Cleartext remains available for
         user-operated Tater Tube Servers on private and link-local networks. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
